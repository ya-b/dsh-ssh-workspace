{
  "name": "@dsh-ssh-workspace/bundle",
  "description": "Remote workspaces for DeepSeek Harness: pick a machine and directory; the workspace UI, terminal, and remote_* tools run on the host while ordinary tools stay local",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./mount": "./lib/mount.js",
    "./api": "./lib/api.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/ssh-workspace.patch.yml"
      ]
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "build:packages": "pnpm -r run build",
    "test": "pnpm -r --no-bail run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.1-rc.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "~5.9.0",
    "@types/node": "^26.0.0",
    "@vscode/ripgrep": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "zod": "^4.4.3",
    "vitest": "^3.2.0",
    "@dsh-ssh-workspace/rpc": "workspace:*",
    "@dsh-ssh-workspace/transport": "workspace:*",
    "@dsh-ssh-workspace/mount": "workspace:*",
    "@dsh-ssh-workspace/install": "workspace:*",
    "@dsh-ssh-workspace/providers": "workspace:*",
    "@dsh-ssh-workspace/api": "workspace:*",
    "@dsh-ssh-workspace/ui": "workspace:*",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-ssh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.4",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.4",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-rc.4"
  }
}
